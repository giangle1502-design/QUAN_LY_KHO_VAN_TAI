rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Quản trị gốc được xóa mọi bản ghi (duyệt yêu cầu xóa, xóa dữ liệu chạy thử)
    match /{coll}/{id} {
      allow delete: if isSuper();
    }

    // ==== Email quản trị gốc (sửa cho khớp VITE_SUPER_ADMINS) ====
    function superAdmins() { return ['giangle1502@gmail.com', 'gianglevan.vap@gmail.com']; }

    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }
    function userPath() { return /databases/$(database)/documents/users/$(me()); }
    function profile() { return get(userPath()).data; }
    function isSuper() { return signedIn() && me() in superAdmins(); }
    function isActive() { return signedIn() && exists(userPath()) && profile().active != false; }
    function isStaff() { return isSuper() || isActive(); }
    function isAdmin() { return isSuper() || (isActive() && profile().role == 'admin'); }
    function hasRole(r) { return isActive() && profile().role == r; }
    // Kho được giao: danh sách rỗng hoặc không khai báo = tất cả kho
    // Quản trị (kể cả quản trị gốc chưa có hồ sơ users) được thao tác mọi kho
    function inMyWarehouse(wh) {
      return isAdmin() || !('warehouses' in profile()) || profile().warehouses.size() == 0 || wh in profile().warehouses;
    }

    // Phân quyền: ai cũng đọc được hồ sơ của mình; quản trị đọc/sửa tất cả
    match /users/{email} {
      allow read: if signedIn() && (email == me() || isStaff());
      allow create, update: if isAdmin();
      // Điều phối vận tải tạo / khóa tài khoản tài xế của đơn vị mình
      // GHA tạo thêm tài khoản 3PL (thầu phụ) thuộc GHA
      allow create, update: if hasRole('van_tai') && myCarrier() != ''
        && (request.resource.data.role == 'tai_xe' || (request.resource.data.role == 'tpl' && gha()))
        && request.resource.data.carrier == myCarrier()
        && (resource == null || (resource.data.get('role', '') in ['tai_xe', 'tpl'] && resource.data.get('carrier', '') == myCarrier()));
    }

    // Cấu hình hạng mục và cài đặt chung
    match /settings/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      // Người được cấp quyền "Thiết lập biểu mẫu" tự thêm / sửa trường
      allow create, update: if id == 'fields' && isActive() && profile().formDesigner == true;
      // Nút (+) thêm lựa chọn cho trường danh sách chọn ngay trên form (vd. Hãng tàu)
      allow create, update: if id == 'choices' && isActive()
        && (profile().role in ['admin', 'kinh_doanh', 'ke_toan', 'thu_kho'] || profile().formDesigner == true);
    }

    // Mẫu in tự thiết kế: mọi người đọc để in; quản trị và người được thiết lập biểu mẫu tạo / sửa; xóa qua Duyệt xóa (quản trị gốc)
    match /printTemplates/{id} {
      allow read: if isStaff();
      allow create, update: if (isAdmin() || (isActive() && profile().get('formDesigner', false) == true))
        && request.resource.data.id == id && request.resource.data.docType is string;
      allow delete: if isSuper();
    }

    // ==== Chuyến xe ====
    // Chuyển trạng thái hợp lệ theo vai trò (quản trị được làm mọi bước)
    function st(from, to) { return resource.data.status == from && request.resource.data.status == to; }
    function guardStep() {
      return st('arrived', 'waiting_gate')
        || st('waiting_exit', 'waiting_delivery') || st('waiting_exit', 'completed');
    }
    function dockStep() {
      return st('waiting_gate', 'processing')
        || st('processing', 'waiting_exit') || st('processing', 'waiting_delivery') || st('processing', 'completed');
    }
    function sameTrip() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'gateConfirmTime', 'dock', 'dockAssignTime', 'processDoneTime', 'gateExitTime',
        'deliveryCompleteTime', 'updatedAt', 'updatedBy', 'history']);
    }
    // ==== Vận tải theo chuyến (điều phối chia xe, tài xế xác nhận từng bước) ====
    function myCarrier() { return profile().get('carrier', ''); }
    function myIdCard() { return profile().get('idCard', ''); }
    function ownCarrierTrip() {
      return myCarrier() != '' && resource.data.get('source', '') == 'plan'
        && resource.data.get('carrier', '') == myCarrier() && request.resource.data.get('carrier', '') == myCarrier();
    }
    function stepStatus(canCancel) {
      return request.resource.data.status == resource.data.status
        || (resource.data.status == 'planned' && request.resource.data.status in ['arrived', 'waiting_gate'])
        || (resource.data.status == 'waiting_delivery' && request.resource.data.status == 'completed')
        || ((resource.data.get('hasGuard', true) == false || resource.data.get('pickup', '') != '')
          && resource.data.status in ['planned', 'waiting_gate'] && request.resource.data.status in ['waiting_delivery', 'completed'])
        || (canCancel && resource.data.status == 'planned' && request.resource.data.status == 'cancelled');
    }
    // Link tài xế (không cần tài khoản): phiên ẩn danh gắn với 1 đơn vị vận tải qua mã bí mật carrierLinks/{đơn vị}.token
    // (đổi mã trong app là link cũ hết hiệu lực)
    function txPath() { return /databases/$(database)/documents/txSessions/$(request.auth.uid); }
    function txCarrier() { return get(txPath()).data.carrier; }
    function txOk() {
      return request.auth != null && request.auth.token.get('email', null) == null && exists(txPath())
        && get(/databases/$(database)/documents/carrierLinks/$(txCarrier())).data.get('token', '') == get(txPath()).data.token;
    }
    function driverKeys() {
      return ['plate', 'vehicleType', 'idCard', 'driverName', 'driverPhone', 'status', 'arrivalTime', 'arrivalDate', 'gateConfirmTime',
        'driverRegAt', 'driverArrivedAt', 'driverLoadedAt', 'driverAtDestAt', 'driverDeliveredAt', 'deliveryCompleteTime', 'lines', 'photoCount',
        'history', 'updatedAt', 'updatedBy'];
    }
    function costKeys() { return ['costs', 'costStatus', 'costBy', 'costAt']; }
    // Không tự chốt chi phí; kế toán chốt rồi thì không sửa nữa
    function costOk(allowed) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(costKeys())
        || (resource.data.get('costStatus', '') != 'approved' && request.resource.data.get('costStatus', '') in allowed);
    }
    // GHA: đơn vị vận tải được dùng 3PL
    function gha() {
      return hasRole('van_tai') && myCarrier() != ''
        && (get(/databases/$(database)/documents/carriers/$(myCarrier())).data.get('uses3PL', false) == true
          || get(/databases/$(database)/documents/carriers/$(myCarrier())).data.get('kind', '') == 'GHA');
    }
    // 3PL (thầu phụ GHA): chuyến GHA đã chỉ định cho 3PL của tài khoản này
    function myThreepl() { return profile().get('threepl', ''); }
    function myTrip3pl(id) {
      return myThreepl() != ''
        && get(/databases/$(database)/documents/tripPrivate/$(id)).data.get('threepl', '') == myThreepl();
    }
    match /txSessions/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['carrier', 'token', 'at'])
        && request.resource.data.token is string && request.resource.data.token.size() >= 16
        && get(/databases/$(database)/documents/carrierLinks/$(request.resource.data.carrier)).data.get('token', '') == request.resource.data.token;
    }
    // Mã link tài xế của từng đơn vị: quản trị tạo / đổi; điều phối, 3PL của đơn vị đọc để gửi link
    match /carrierLinks/{code} {
      allow read: if isAdmin() || ((hasRole('van_tai') || hasRole('tpl')) && myCarrier() == code);
      allow write: if isAdmin() || (hasRole('van_tai') && myCarrier() == code);
    }
    match /trips/{id} {
      allow read: if isStaff();
      // Link tài xế: thấy chuyến của đơn vị vận tải trên link
      allow read: if txOk() && resource.data.get('carrier', '') == txCarrier();
      // Tài xế mở link của đơn vị (không tài khoản): như tài xế, chỉ trong chuyến của đơn vị trên link
      // (để riêng, trước các quy tắc khác, cho nhẹ phần tính quyền)
      allow update: if request.auth != null && request.auth.token.get('email', null) == null
        && resource.data.get('source', '') == 'plan' && request.resource.data.get('carrier', '') == resource.data.get('carrier', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(driverKeys())
        && request.resource.data.get('plate', '') != ''
        && resource.data.get('plate', '') in ['', request.resource.data.get('plate', '')]
        && stepStatus(false)
        && txOk() && resource.data.get('carrier', '') == txCarrier();
      allow create: if (isAdmin() || ((hasRole('bao_ve') || hasRole('thu_kho')) && inMyWarehouse(request.resource.data.warehouse)))
        && request.resource.data.status in ['arrived', 'waiting_gate']
        && request.resource.data.createdBy == me();
      // Chia xe: chuyến chờ xe đến kho
      allow create: if (isAdmin() || (hasRole('van_tai') && myCarrier() != '' && request.resource.data.carrier == myCarrier()))
        && request.resource.data.status == 'planned' && request.resource.data.source == 'plan'
        && request.resource.data.createdBy == me();
      allow update: if isAdmin()
        || (inMyWarehouse(resource.data.warehouse) && sameTrip()
            && ((hasRole('bao_ve') && guardStep()) || (hasRole('thu_kho') && dockStep())))
        // Điều phối vận tải: sửa chuyến, làm thay tài xế, nhập chi phí
        || (hasRole('van_tai') && ownCarrierTrip() && stepStatus(true) && costOk(['entered'])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(driverKeys().concat(costKeys()).concat(['plannedDate', 'note', 'cancelReason', 'cancelTime', 'pickup', 'pickupName', 'pickupAddress', 'pickupMap'])))
        // Tài xế: nhập số xe (chuyến chưa có xe) hoặc chạy chuyến điều phối đã chỉ định cho xe đó, xác nhận từng bước;
        // không đổi được xe điều phối đã chỉ định, không nhập / sửa cước. Xe thuê ngoài không cần có trong danh mục, không cần CCCD
        || (hasRole('tai_xe') && ownCarrierTrip()
          && request.resource.data.get('plate', '') != ''
          && resource.data.get('plate', '') in ['', request.resource.data.get('plate', '')]
          && stepStatus(false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(driverKeys()))
        // 3PL: nhập số xe, tài xế, xác nhận các bước của chuyến GHA chỉ định cho mình (không sửa cước GHA)
        || (hasRole('tpl') && ownCarrierTrip() && myTrip3pl(id)
          && stepStatus(false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(driverKeys()))
        // Kế toán nhập / sửa / chốt chi phí chuyến (xe nội bộ cập nhật cước sau)
        || (hasRole('ke_toan') && request.resource.data.get('costStatus', '') in ['entered', 'approved']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(costKeys().concat(['costApprovedBy', 'costApprovedAt', 'history', 'updatedAt', 'updatedBy'])));
    }
    // Ảnh phiếu giao hàng (nén, lưu thẳng Firestore)
    match /tripPhotos/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.by == me() && request.resource.data.data.size() < 900000
        && (isAdmin() || ((hasRole('van_tai') || hasRole('tai_xe') || hasRole('tpl')) && request.resource.data.carrier == myCarrier()));
      allow create: if txOk() && request.resource.data.carrier == txCarrier() && request.resource.data.data.size() < 900000;
      // Thay / xóa ảnh chụp sai: quản trị, điều phối vận tải, 3PL của đơn vị
      allow delete: if isAdmin() || ((hasRole('van_tai') || hasRole('tpl')) && resource.data.carrier == myCarrier());
    }
    // 3PL của chuyến: chỉ GHA và quản trị gốc (admin khách không đọc được)
    match /tripPrivate/{id} {
      allow read: if isSuper() || (gha() && resource.data.carrier == myCarrier())
        || (hasRole('tpl') && myThreepl() != '' && resource.data.get('threepl', '') == myThreepl());
      allow create, update: if isSuper() || (gha() && request.resource.data.carrier == myCarrier());
      // 3PL nhập cước 3PL ↔ GHA của chuyến mình (GHA chốt rồi thì không sửa)
      allow update: if hasRole('tpl') && myThreepl() != '' && resource.data.get('threepl', '') == myThreepl()
        && resource.data.get('cost3plStatus', '') != 'approved' && request.resource.data.get('cost3plStatus', '') == 'entered'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['cost3pl', 'cost3plStatus', 'cost3plBy', 'cost3plAt', 'updatedAt', 'updatedBy', 'updatedByName']);
    }
    // Bảng kê cước: đơn vị vận tải (cước với công ty) hoặc 3PL ↔ GHA; 2 bên cùng xem, bên kia xác nhận
    function stmtOk(d) {
      return (d.kind == 'carrier' && (isAdmin() || hasRole('ke_toan') || (hasRole('van_tai') && d.carrier == myCarrier())))
        || (d.kind == '3pl' && (isSuper() || (gha() && d.carrier == myCarrier())));
    }
    function stmtMine3pl(d) { return hasRole('tpl') && myThreepl() != '' && d.kind == '3pl' && d.party == myThreepl(); }
    match /statements/{id} {
      allow read: if stmtOk(resource.data) || stmtMine3pl(resource.data);
      allow create: if stmtOk(request.resource.data) && request.resource.data.createdBy == me();
      allow update: if (stmtOk(resource.data) && stmtOk(request.resource.data))
        || (stmtMine3pl(resource.data) && request.resource.data.status == 'confirmed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt', 'confirmedBy', 'confirmedByName', 'total', 'count']));
    }
    match /threepl/{id} {
      allow read, create, update: if isSuper() || gha();
    }

    // Cấp số chứng từ: nhân viên vận hành chỉ được tăng "Số tiếp theo"
    function opStaff() { return hasRole('bao_ve') || hasRole('thu_kho') || hasRole('ke_toan') || hasRole('kinh_doanh') || hasRole('van_tai'); }
    match /codeRules/{code} {
      allow create: if opStaff() && code in ['GRP', 'SP', 'PN', 'PX', 'CV', 'TC', 'DC', 'SO', 'PO', 'STO', 'DRT', 'RTV']
        && request.resource.data.next > 1;
      allow update: if opStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
        && request.resource.data.next > resource.data.next
        && request.resource.data.next <= resource.data.next + 10;
    }

    // Số thứ tự theo ngày (vd. đề nghị giải chấp HSGC + yymmdd + NN): chỉ tăng dần
    match /counters/{id} {
      allow read: if isStaff();
      allow create: if (isAdmin() || hasRole('ke_toan') || hasRole('thu_kho')) && request.resource.data.next == 2;
      allow update: if (isAdmin() || hasRole('ke_toan') || hasRole('thu_kho')) && request.resource.data.next == resource.data.next + 1;
    }

    // ==== Đề nghị giải chấp (kế toán lập, hoặc tự lập khi thủ kho xuất bán hàng HTC; lưu là đổi HTC → DGC) ====
    match /releaseRequests/{id} {
      allow read: if isStaff();
      allow create: if (isAdmin() || hasRole('ke_toan') || hasRole('thu_kho')) && inMyWarehouse(request.resource.data.warehouse)
        && request.resource.data.id == id && request.resource.data.createdBy == me() && request.resource.data.status == 'sent';
      allow update: if (isAdmin() || hasRole('ke_toan') || hasRole('thu_kho')) && inMyWarehouse(resource.data.warehouse)
        && request.resource.data.id == resource.data.id && request.resource.data.warehouse == resource.data.warehouse;
    }

    // ==== Thông báo cho kế toán (chuông 🔔): phiếu xuất lấy tồn công ty khác cùng chủ → chuyển pháp nhân ====
    match /notices/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.createdBy == me()
        && (request.resource.data.status == 'open' || (request.resource.data.status == 'done' && (isAdmin() || hasRole('ke_toan'))));
      allow update: if (isAdmin() || hasRole('ke_toan'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneBy', 'doneByName', 'doneAt', 'doneNote']);
    }

    // ==== Trò chuyện: riêng (dm), nhóm (quản trị tạo), tin hệ thống (sys) ====
    // members: email thành viên; ['*'] = kênh thông báo chung cho mọi người
    function chatPath(cid) { return /databases/$(database)/documents/chats/$(cid); }
    function inChat(d) { return me() in d.members || '*' in d.members; }
    function lastKeys() { return ['lastText', 'lastAt', 'lastBy', 'lastByName', 'lastSys']; }
    match /chats/{cid} {
      allow read: if isStaff() && (me() in resource.data.members || '*' in resource.data.members);
      allow read: if isAdmin() && resource.data.type == 'group';
      // Trò chuyện riêng: 2 người, mình là 1 trong 2
      allow create: if isStaff() && request.resource.data.type == 'dm' && request.resource.data.members.size() == 2
        && me() in request.resource.data.members && request.resource.data.createdBy == me();
      // Nhóm: quản trị tạo, sửa tên / thành viên
      allow create, update: if isAdmin() && request.resource.data.type == 'group';
      // Hộp thông báo hệ thống: riêng 1 người hoặc kênh chung; ai lập chứng từ cũng gửi được
      allow create: if isStaff() && request.resource.data.type == 'sys' && request.resource.data.lastBy == me()
        && (request.resource.data.members == ['*'] || request.resource.data.members.size() == 1);
      // Tin mới: cập nhật dòng xem trước (cả tin hệ thống gửi vào nhóm mình không ở trong)
      allow update: if isStaff() && request.resource.data.lastBy == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(lastKeys());
      match /messages/{mid} {
        allow read: if isStaff() && inChat(get(chatPath(cid)).data);
        // Thành viên gửi tin (hộp hệ thống chỉ quản trị gửi vào kênh chung); tin hệ thống (sys) ai lập chứng từ cũng gửi được
        allow create: if isStaff() && request.resource.data.by == me() && request.resource.data.keys().hasOnly(['text', 'by', 'byName', 'at', 'sys', 'event', 'ref', 'link'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000
          && (request.resource.data.get('sys', false) == true
            || (inChat(getAfter(chatPath(cid)).data) && (getAfter(chatPath(cid)).data.type != 'sys' || isAdmin())));
      }
    }
    // Đã đọc tới đâu: mỗi người 1 tài liệu riêng
    match /chatReads/{email} {
      allow read, write: if isStaff() && email == me();
    }

    // ==== Pallet gỗ / nhựa: tồn theo kho, đang cho vận tải mượn, sổ nhập / trả / điều chỉnh ====
    match /palletStock/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || (hasRole('thu_kho') && inMyWarehouse(request.resource.data.warehouse)
        && (resource == null || resource.data.warehouse == request.resource.data.warehouse));
    }
    match /palletCarrier/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || hasRole('thu_kho');
    }
    match /palletMoves/{id} {
      allow read: if isStaff();
      allow create: if (isAdmin() || (hasRole('thu_kho') && inMyWarehouse(request.resource.data.warehouse)))
        && request.resource.data.createdBy == me() && request.resource.data.id == id;
    }

    // ==== Kiểm kê / cycle count: đầu phiếu + dòng đếm (thủ kho, quản trị của kho đó) ====
    function countPath(cid) { return /databases/$(database)/documents/stockCounts/$(cid); }
    match /stockCounts/{cid} {
      allow read: if isStaff();
      allow create: if (isAdmin() || hasRole('thu_kho')) && inMyWarehouse(request.resource.data.warehouse)
        && request.resource.data.id == cid && request.resource.data.createdBy == me() && request.resource.data.status == 'preparing';
      allow update: if (isAdmin() || hasRole('thu_kho')) && inMyWarehouse(resource.data.warehouse)
        && request.resource.data.id == resource.data.id && request.resource.data.warehouse == resource.data.warehouse
        && request.resource.data.createdBy == resource.data.createdBy
        // Duyệt (điều chỉnh / không điều chỉnh) và hủy phiếu đã chốt: chỉ quản trị gốc
        && (isSuper() || (!(request.resource.data.status in ['adjusted', 'closed']) && !(resource.data.status in ['adjusted', 'closed'])
          && !(resource.data.status == 'done' && request.resource.data.status == 'cancelled')));
      match /lines/{lid} {
        allow read: if isStaff();
        allow create, update: if (isAdmin() || hasRole('thu_kho')) && inMyWarehouse(get(countPath(cid)).data.warehouse)
          && get(countPath(cid)).data.status in ['preparing', 'open']
          && (resource == null || (request.resource.data.no == resource.data.no && request.resource.data.stockId == resource.data.stockId
            && request.resource.data.sysKg == resource.data.sysKg));
      }
    }

    // ==== Phiếu kho và tồn kho ====
    // Tồn và pallet vị trí chỉ được đổi cùng lúc với 1 phiếu mới do chính người đó lập
    function mvPath(mid) { return /databases/$(database)/documents/movements/$(mid); }
    function freshMovement(mid, wh) {
      return (!exists(mvPath(mid)) && existsAfter(mvPath(mid))
        && getAfter(mvPath(mid)).data.createdBy == me()
        && getAfter(mvPath(mid)).data.warehouse == wh) || confirmingIn(mid, wh);
    }
    // Thủ kho xác nhận phiếu nhập đang chờ nhận hàng (quản trị lập trước), hoặc ghi xuất kho phiếu xuất
    // chờ giải chấp khi lập lệnh giải chấp, trong cùng giao dịch
    function confirmingIn(mid, wh) {
      return exists(mvPath(mid)) && get(mvPath(mid)).data.status in ['pending', 'wait_release']
        && getAfter(mvPath(mid)).data.status == 'posted' && getAfter(mvPath(mid)).data.confirmedBy == me()
        && getAfter(mvPath(mid)).data.warehouse == wh;
    }
    match /movements/{id} {
      allow read: if isStaff();
      allow create: if request.resource.data.createdBy == me()
        && (request.resource.data.status == 'posted' || (request.resource.data.status == 'pending' && request.resource.data.type == 'in')
          || (request.resource.data.status == 'wait_release' && request.resource.data.type == 'out'))
        && request.resource.data.id == id
        // Phiếu điều chỉnh theo kiểm kê: chỉ quản trị gốc (người duyệt)
        && (request.resource.data.get('countId', '') == '' || isSuper())
        && (isAdmin() || (inMyWarehouse(request.resource.data.warehouse)
          && ((hasRole('thu_kho') && request.resource.data.type in ['in', 'out', 'move', 'adjust'])
            || (hasRole('ke_toan') && request.resource.data.type == 'status')
            // Thủ kho xuất bán hàng HTC: phiếu TC giải chấp theo đề nghị
            || (hasRole('thu_kho') && request.resource.data.type == 'status' && request.resource.data.get('releaseId', '') != ''))));
      allow update: if isAdmin()
        || (hasRole('thu_kho') && resource.data.status == 'pending' && request.resource.data.status == 'posted'
          && resource.data.type == 'in' && request.resource.data.type == 'in' && inMyWarehouse(resource.data.warehouse)
          && request.resource.data.warehouse == resource.data.warehouse && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.confirmedBy == me())
        // Lệnh giải chấp: đổi dòng HTC của phiếu xuất chờ giải chấp sang DGC, rồi ghi xuất kho (thủ kho, kế toán)
        || ((hasRole('thu_kho') || hasRole('ke_toan')) && resource.data.type == 'out' && resource.data.status == 'wait_release'
          && inMyWarehouse(resource.data.warehouse) && request.resource.data.type == 'out'
          && request.resource.data.warehouse == resource.data.warehouse && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && (request.resource.data.status == 'wait_release' || (request.resource.data.status == 'posted' && request.resource.data.confirmedBy == me())))
        // Thủ kho bổ sung / sửa thông tin vận tải của phiếu xuất sau khi lập
        || (hasRole('thu_kho') && resource.data.type == 'out' && resource.data.status != 'cancelled' && inMyWarehouse(resource.data.warehouse)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['plate', 'carrier', 'carrierName', 'idCard', 'driverName', 'driverPhone', 'palletMode', 'pallets', 'history', 'updatedAt', 'updatedBy']));
    }
    match /stock/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        || ((hasRole('thu_kho') || hasRole('ke_toan')) && inMyWarehouse(request.resource.data.warehouse)
          && (resource == null || resource.data.warehouse == request.resource.data.warehouse)
          && freshMovement(request.resource.data.lastMovement, request.resource.data.warehouse));
    }
    match /locations/{id} {
      allow update: if (hasRole('thu_kho') || hasRole('ke_toan')) && inMyWarehouse(resource.data.warehouse)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['currentPallets', 'usedPct', 'emptyBin', 'lastMovement', 'updatedAt', 'updatedBy'])
        && freshMovement(request.resource.data.lastMovement, resource.data.warehouse);
    }

    // ==== Đơn bán (SO) / đơn mua (PO) ====
    // Kinh doanh, kế toán lập/sửa/đóng SO, PO, STO; thủ kho lập/sửa STO mà mọi kho xuất đều là kho của mình.
    // Thủ kho chỉ cập nhật "đã giao/nhận" khi ghi phiếu kho mới gắn đơn đó
    function orderMgr() { return hasRole('kinh_doanh') || hasRole('ke_toan'); }
    // Kinh doanh chỉ thấy / sửa đơn có Sale phụ trách là mình (trừ người được tích "xem đơn của mọi sale")
    function salesOnly() { return hasRole('kinh_doanh') && profile().get('seeAllOrders', false) != true; }
    function mySale(d) { return !salesOnly() || d.get('sales', '') == me(); }
    function movementForOrder(mid, oid) {
      return ((!exists(mvPath(mid)) && existsAfter(mvPath(mid)) && getAfter(mvPath(mid)).data.createdBy == me())
          || (exists(mvPath(mid)) && get(mvPath(mid)).data.status in ['pending', 'wait_release']
            && getAfter(mvPath(mid)).data.status == 'posted' && getAfter(mvPath(mid)).data.confirmedBy == me()))
        // Phiếu nhập theo SO trả hàng (DRT) cập nhật cả SO gốc (originalSoId)
        && (getAfter(mvPath(mid)).data.orderId == oid || getAfter(mvPath(mid)).data.get('originalSoId', '') == oid
          || getAfter(mvPath(mid)).data.get('originalPoId', '') == oid);
    }
    // STO: kho xuất ghi theo từng dòng (fromWarehouses); lệnh cũ ghi ở đầu đơn (fromWarehouse)
    function allMine(list) {
      return isAdmin() || !('warehouses' in profile()) || profile().warehouses.size() == 0 || list.toSet().difference(profile().warehouses.toSet()).size() == 0;
    }
    function stoFromMine(d) {
      return 'fromWarehouses' in d ? d.fromWarehouses.size() > 0 && allMine(d.fromWarehouses) : inMyWarehouse(d.fromWarehouse);
    }
    match /orders/{id} {
      allow read: if isStaff() && mySale(resource.data);
      allow create: if (isAdmin() || (orderMgr() && mySale(request.resource.data))
          || (hasRole('thu_kho') && request.resource.data.type == 'STO' && stoFromMine(request.resource.data)))
        && request.resource.data.id == id && request.resource.data.createdBy == me()
        && request.resource.data.status == 'open' && request.resource.data.type in ['SO', 'PO', 'STO', 'DRT', 'RTV']
        // Nhập trực tiếp: thủ kho lập PO đã nhận đủ cùng lúc với phiếu nhập kho gắn PO đó
        || ((isAdmin() || hasRole('thu_kho')) && request.resource.data.type == 'PO' && request.resource.data.direct == true
          && request.resource.data.id == id && request.resource.data.createdBy == me() && request.resource.data.status == 'done'
          && movementForOrder(request.resource.data.lastMovement, id));
      allow update: if isAdmin()
        || (orderMgr() && mySale(resource.data) && mySale(request.resource.data) && request.resource.data.type == resource.data.type
          && request.resource.data.id == resource.data.id && request.resource.data.createdBy == resource.data.createdBy)
        || (hasRole('thu_kho') && resource.data.type == 'STO' && request.resource.data.type == 'STO'
          && stoFromMine(resource.data) && stoFromMine(request.resource.data) && request.resource.data.createdBy == resource.data.createdBy)
        || (hasRole('thu_kho')
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lines', 'status', 'lastMovement', 'updatedAt', 'updatedBy'])
          && request.resource.data.status in ['open', 'partial', 'done', 'closed']
          && movementForOrder(request.resource.data.lastMovement, id));
    }

    // Kế hoạch phân bổ hàng mua: kinh doanh, kế toán, quản trị lập / sửa; chỉ quản trị gốc xóa (duyệt yêu cầu xóa)
    // Dự kiến xuất kho: Sale lập từ SO của mình; quản trị kho / thủ kho lập phiếu xuất từ đó, cập nhật số đã xuất
    match /shipPlans/{id} {
      allow read: if isStaff() && mySale(resource.data);
      allow create: if (isAdmin() || orderMgr()) && mySale(request.resource.data)
        && request.resource.data.id == id && request.resource.data.createdBy == me() && request.resource.data.status == 'open';
      allow update: if (isAdmin() || (orderMgr() && mySale(resource.data) && mySale(request.resource.data)))
          && request.resource.data.id == resource.data.id && request.resource.data.createdBy == resource.data.createdBy
        || (hasRole('thu_kho') && resource.data.status in ['open', 'partial'] && request.resource.data.status in ['partial', 'done']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lines', 'status', 'movementIds', 'doneAt', 'updatedAt', 'updatedBy']));
    }

    match /allocations/{id} {
      allow read: if isStaff();
      allow create: if (isAdmin() || orderMgr()) && request.resource.data.id == id && request.resource.data.createdBy == me();
      allow update: if (isAdmin() || orderMgr()) && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.poId == resource.data.poId;
    }

    // Giá trị trường đơn hàng chỉ người được chỉ định xem (vd. Đơn giá): người trong viewers (email hoặc vai trò) và quản trị
    // salesSees: sale phụ trách của đơn (sales) xem được giá trị trong đơn của mình, vd. Giá bán
    function seesSecret(d) {
      return isAdmin() || me() in d.viewers || (isActive() && profile().get('role', '') in d.viewers)
        || (d.get('salesSees', false) == true && d.get('sales', '') == me() && hasRole('kinh_doanh'));
    }
    match /orderSecrets/{id} {
      allow read: if isStaff() && seesSecret(resource.data);
      allow create: if isStaff() && (isAdmin() || orderMgr() || hasRole('thu_kho')) && seesSecret(request.resource.data)
        && id == request.resource.data.orderId + '__' + request.resource.data.field;
      allow update: if isStaff() && (isAdmin() || ((orderMgr() || hasRole('thu_kho')) && seesSecret(resource.data)
        && request.resource.data.viewers == resource.data.viewers && request.resource.data.field == resource.data.field
        && request.resource.data.get('salesSees', false) == resource.data.get('salesSees', false)
        && request.resource.data.orderId == resource.data.orderId));
      allow delete: if isAdmin();
    }

    // ==== Xóa dữ liệu ====
    // Chỉ quản trị gốc xóa thẳng; người khác gửi yêu cầu xóa để quản trị gốc duyệt
    match /deleteRequests/{id} {
      allow read: if isSuper() || (isStaff() && resource.data.requestedBy == me());
      allow create: if isStaff() && request.resource.data.id == id && request.resource.data.requestedBy == me()
        && (request.resource.data.status == 'pending' || (isSuper() && request.resource.data.status in ['deleted', 'reset']));
      allow update: if isSuper();
    }

    // Danh mục thủ kho được sửa trong kho của mình (không sửa tồn kho hiện tại)
    match /{coll}/{id} {
      allow get: if coll == 'carriers' && txOk() && id == txCarrier();
      allow read: if coll == 'vehicles' && txOk() && resource.data.get('carrier', '') == txCarrier();
      allow read: if isStaff() && coll in [
        'companies', 'partners', 'soldto', 'shipto', 'items', 'goodsStatus', 'pledgees', 'suppliers', 'warehouses',
        'locations', 'docks', 'reasons', 'carriers', 'vehicles', 'drivers', 'codeRules', 'freightRates', 'pallets', 'pickupPoints'];
      allow create, update: if isAdmin() && coll in [
        'companies', 'partners', 'soldto', 'shipto', 'items', 'goodsStatus', 'pledgees', 'suppliers', 'warehouses',
        'locations', 'docks', 'reasons', 'carriers', 'vehicles', 'drivers', 'codeRules', 'freightRates', 'pallets', 'pickupPoints'];
      // Kinh doanh, kế toán thêm/sửa nhanh khách hàng, địa chỉ giao, mã hàng ngay khi lập đơn (không xóa)
      allow create, update: if coll in ['partners', 'soldto', 'shipto', 'items', 'suppliers'] && (hasRole('kinh_doanh') || hasRole('ke_toan'));
      // Kế toán quản lý bảng giá cước
      allow create, update: if coll == 'freightRates' && hasRole('ke_toan');
      // Điểm nhận hàng (cảng…): điều phối vận tải, kế toán thêm nhanh khi nhập chuyến
      allow create, update: if coll == 'pickupPoints' && (hasRole('ke_toan') || hasRole('van_tai'));
      // Đơn vị vận tải thêm / sửa xe, tài xế của đơn vị mình
      allow create, update: if coll in ['vehicles', 'drivers'] && hasRole('van_tai') && profile().get('carrier', '') != ''
        && request.resource.data.carrier == profile().get('carrier', '') && (resource == null || resource.data.carrier == profile().get('carrier', ''));
      // Thêm nhanh lý do ngay trên phiếu kho / đơn hàng
      allow create, update: if coll == 'reasons' && (hasRole('thu_kho') || hasRole('kinh_doanh') || hasRole('ke_toan'));
      allow create: if coll in ['locations', 'docks'] && hasRole('thu_kho')
        && inMyWarehouse(request.resource.data.warehouse)
        && (coll != 'locations' || request.resource.data.currentPallets in [0, null]);
      allow update: if coll in ['locations', 'docks'] && hasRole('thu_kho')
        && inMyWarehouse(resource.data.warehouse)
        && request.resource.data.warehouse == resource.data.warehouse
        && (coll != 'locations' || request.resource.data.currentPallets == resource.data.currentPallets);
    }
  }
}
