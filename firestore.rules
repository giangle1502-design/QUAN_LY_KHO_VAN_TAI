rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==== Email quản trị gốc (sửa cho khớp VITE_SUPER_ADMINS) ====
    function superAdmins() { return ['giangle1502@gmail.com']; }

    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }
    function userPath() { return /databases/$(database)/documents/users/$(me()); }
    function profile() { return get(userPath()).data; }
    function isSuper() { return signedIn() && me() in superAdmins(); }
    function isActive() { return signedIn() && exists(userPath()) && profile().active != false; }
    function isStaff() { return isSuper() || isActive(); }
    function isAdmin() { return isSuper() || (isActive() && profile().role == 'admin'); }
    function hasRole(r) { return isActive() && profile().role == r; }
    // Kho được giao: danh sách rỗng hoặc không khai báo = tất cả kho
    function inMyWarehouse(wh) {
      return !('warehouses' in profile()) || profile().warehouses.size() == 0 || wh in profile().warehouses;
    }

    // Phân quyền: ai cũng đọc được hồ sơ của mình; quản trị đọc/sửa tất cả
    match /users/{email} {
      allow read: if signedIn() && (email == me() || isStaff());
      allow write: if isAdmin();
    }

    // Cấu hình hạng mục và cài đặt chung
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ==== Chuyến xe ====
    // Chuyển trạng thái hợp lệ theo vai trò (quản trị được làm mọi bước)
    function st(from, to) { return resource.data.status == from && request.resource.data.status == to; }
    function guardStep() {
      return st('arrived', 'waiting_gate')
        || st('waiting_exit', 'waiting_delivery') || st('waiting_exit', 'completed');
    }
    function dockStep() {
      return st('waiting_gate', 'processing')
        || st('processing', 'waiting_exit') || st('processing', 'waiting_delivery') || st('processing', 'completed');
    }
    function sameTrip() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'gateConfirmTime', 'dock', 'dockAssignTime', 'processDoneTime', 'gateExitTime',
        'deliveryCompleteTime', 'updatedAt', 'updatedBy', 'history']);
    }
    match /trips/{id} {
      allow read: if isStaff();
      allow create: if (isAdmin() || ((hasRole('bao_ve') || hasRole('thu_kho')) && inMyWarehouse(request.resource.data.warehouse)))
        && request.resource.data.status in ['arrived', 'waiting_gate']
        && request.resource.data.createdBy == me();
      allow update: if isAdmin()
        || (inMyWarehouse(resource.data.warehouse) && sameTrip()
            && ((hasRole('bao_ve') && guardStep()) || (hasRole('thu_kho') && dockStep())));
      allow delete: if isAdmin();
    }

    // Cấp số chứng từ: nhân viên vận hành chỉ được tăng "Số tiếp theo"
    match /codeRules/{code} {
      allow create: if (hasRole('bao_ve') || hasRole('thu_kho')) && code in ['GRP', 'SP']
        && request.resource.data.next > 1;
      allow update: if (hasRole('bao_ve') || hasRole('thu_kho'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
        && request.resource.data.next > resource.data.next
        && request.resource.data.next <= resource.data.next + 10;
    }

    // Danh mục thủ kho được sửa trong kho của mình (không sửa tồn kho hiện tại)
    match /{coll}/{id} {
      allow read: if isStaff() && coll in [
        'soldto', 'shipto', 'items', 'goodsStatus', 'pledgees', 'suppliers', 'warehouses',
        'locations', 'docks', 'reasons', 'carriers', 'vehicles', 'drivers', 'threepl', 'codeRules'];
      allow write: if isAdmin() && coll in [
        'soldto', 'shipto', 'items', 'goodsStatus', 'pledgees', 'suppliers', 'warehouses',
        'locations', 'docks', 'reasons', 'carriers', 'vehicles', 'drivers', 'threepl', 'codeRules'];
      allow create: if coll in ['locations', 'docks'] && hasRole('thu_kho')
        && inMyWarehouse(request.resource.data.warehouse)
        && (coll != 'locations' || request.resource.data.currentPallets in [0, null]);
      allow update: if coll in ['locations', 'docks'] && hasRole('thu_kho')
        && inMyWarehouse(resource.data.warehouse)
        && request.resource.data.warehouse == resource.data.warehouse
        && (coll != 'locations' || request.resource.data.currentPallets == resource.data.currentPallets);
    }
  }
}
